<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 home-screen widget: the now-playing screen at a glance.

  Built from RemoteViews by the service, never by Flutter, so it keeps working
  when the UI process is gone, which on a dedicated renderer is most of the
  time. Everything here must therefore be a view RemoteViews can drive:
  LinearLayout, TextView, ImageView, ProgressBar and nothing else.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <!--
      Fixed square rather than match_parent height. A 4x2 cell is wider than it
      is tall, so art sized to the height takes roughly half the width and
      ellipsizes the title, which is the one thing the widget exists to show.
      110dp fills a 2-cell row without crowding the text.
    -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_art_frame"
        android:contentDescription="@string/widget_art"
        android:padding="30dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_album" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="HiFi Renderer" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:text="" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/widget_play_pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressTint="#8CFFFFFF"
            android:progressBackgroundTint="#1FFFFFFF" />

        <LinearLayout
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="#61FFFFFF"
                android:textSize="11sp"
                android:text="" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:text="" />

                <ImageView
                    android:id="@+id/widget_verified"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="5dp"
                    android:contentDescription="@string/widget_bit_perfect"
                    android:src="@drawable/ic_widget_verified"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="#61FFFFFF"
                android:textSize="11sp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
