    "placeholders": {
      "bits": {"type": "int", "example": "24"}
    }
  },

  "dacCapsAsync": "Asynchronous (DAC clock)",
  "@dacCapsAsync": {
    "description": "USB timing value: the DAC provides the clock and the phone follows it. This is the better arrangement for audio quality, which the parenthesis is there to convey."
  },

  "dacCapsSync": "Synchronous",
  "@dacCapsSync": {
    "description": "USB timing value: the DAC follows the phone's clock rather than its own."
  },

  "dacCapsVolumeOverUsb": "Supported over USB",
  "@dacCapsVolumeOverUsb": {
    "description": "Volume control value: the app can set the DAC's volume."
  },

  "dacCapsVolumeDeviceOnly": "On the device only",
  "@dacCapsVolumeDeviceOnly": {
    "description": "Volume control value: volume can only be changed with the DAC's own knob — common on integrated amplifiers."
