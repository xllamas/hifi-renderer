{
  "@@locale": "en",

  "settingsTooltip": "Settings",
  "@settingsTooltip": {
    "description": "Tooltip on the gear button in the corner of the now-playing screen."
  },

  "idleReady": "Ready — waiting for a controller",
  "@idleReady": {
    "description": "Shown on the idle screen when a DAC is attached and the renderer is waiting to be sent a track by a DLNA/OpenHome controller. 'Controller' is the phone or app that tells the renderer what to play; the renderer never chooses for itself."
  },

  "idleNoDac": "No DAC connected",
  "@idleNoDac": {
    "description": "Shown on the idle screen when no USB digital-to-analogue converter is plugged in. DAC is a standard audio abbreviation and is usually left untranslated."
  },

  "unknownTrack": "Unknown track",
  "@unknownTrack": {
    "description": "Shown in place of a track title when the sender gave us none. Must stay short: it is displayed at large size where a title would be."
  },

  "airPlayFromSender": "AirPlay from {sender}",
  "@airPlayFromSender": {
    "description": "Shown in place of a track title while a guest streams over AirPlay and sent no track name. Names the device streaming to us, so the owner can see who has taken the output. 'AirPlay' is an Apple product name and is never translated.",
    "placeholders": {
      "sender": {
        "type": "String",
        "example": "Walrus"
      }
    }
  },

  "previousTrack": "Previous track",
  "@previousTrack": {
    "description": "Tooltip on the skip-backwards button."
  },

  "nextTrack": "Next track",
  "@nextTrack": {
    "description": "Tooltip on the skip-forwards button."
  },

  "pause": "Pause",
  "@pause": {
    "description": "Tooltip on the transport button while audio is playing."
  },

  "play": "Play",
  "@play": {
    "description": "Tooltip on the transport button while audio is stopped or paused."
  },

  "volumeWriteOnly": "This DAC does not report its volume back, so this shows the last value sent from here.",
  "@volumeWriteOnly": {
    "description": "Explains a volume slider whose position cannot be trusted to match the hardware: the DAC accepts a volume but always reports its maximum back, so the number shown is what the app last sent rather than what the device is actually set to. Small print under the slider."
  },

  "systemAudioDetail": "Phone speaker or headphones — resampled by Android",
  "@systemAudioDetail": {
    "description": "Shown when no DAC is attached and audio is going out through the phone itself. 'Resampled' means the sample rate was converted, which is the thing this app exists to avoid, so the wording should not soften it."
  },

  "dacOneOf": "(1 of {count})",
  "@dacOneOf": {
    "description": "Appears after the name of the DAC in use when more than one USB audio device is attached, to say that others were found. Always the first of several.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "bitPerfect": "bit-perfect",
  "@bitPerfect": {
    "description": "The green badge shown when the audio reaches the DAC completely unaltered — not resampled, not volume-adjusted, bit for bit the source. This is the central promise of the whole app, so it should use whatever term audio enthusiasts in the target language actually use; keep it lower case and short enough to sit beside a format badge."
  },

  "systemAudioBadge": "system audio",
  "@systemAudioBadge": {
    "description": "Amber badge shown when audio is going through the phone's own output rather than a USB DAC, and so is not bit-perfect. Short: it sits beside a format badge like 'FLAC 16/44.1'."
  },

  "airPlaySenderResampled": "AirPlay · sender resampled",
  "@airPlaySenderResampled": {
    "description": "Amber badge shown while a guest streams over AirPlay. The audio reaches the DAC untouched by us, but the sending device already converted its sample rate and applied its own volume, so the app must not claim bit-perfect. 'AirPlay' is never translated; the middle dot is a separator. Short: it sits beside a format badge."
  },
  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "Title bar of the settings screen."
  },

  "settingsNetworkName": "Network name",
  "@settingsNetworkName": {
    "description": "Section heading for the name this renderer shows under on the network."
  },

  "settingsNetworkNameHelp": "How this renderer appears in DLNA controllers.",
  "@settingsNetworkNameHelp": {
    "description": "Explains the network name field. A 'controller' is the separate app or device that tells the renderer what to play. DLNA is a standard's name and is not translated."
  },

  "settingsSave": "Save",
  "@settingsSave": {
    "description": "Button that stores the network name. Must be short: it sits in a narrow button beside a text field."
  },

  "settingsSaved": "Saved",
  "@settingsSaved": {
    "description": "Replaces the Save button briefly after saving. Same width constraint as Save."
  },

  "settingsRenamed": "Renamed. Restart the app for controllers to see it.",
  "@settingsRenamed": {
    "description": "Confirmation after the renderer is renamed. The new name only reaches controllers when the renderer re-announces itself on the network, which happens at startup."
  },

  "settingsAudioDevice": "Audio device",
  "@settingsAudioDevice": {
    "description": "Section heading for choosing which USB DAC to play through."
  },

  "settingsDacsMultiple": "{count} USB audio devices are attached. Choose which one to play through; the choice is remembered across reboots.",
  "@settingsDacsMultiple": {
    "description": "Explains the DAC chooser when more than one USB audio device is plugged in — often a hub with several things on it.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "settingsDacsSingle": "One USB audio device is attached. Tap it to play through it, and to grant access if it has not been granted yet.",
  "@settingsDacsSingle": {
    "description": "Explains the DAC list when exactly one device is attached. Android requires the user to grant access to a USB device before an app may open it, and tapping the entry is what asks."
  },

  "settingsUsbAudioDevice": "USB audio device",
  "@settingsUsbAudioDevice": {
    "description": "Fallback label for an attached device that did not report a name of its own."
  },

  "settingsPermissionNotGranted": " — permission not granted",
  "@settingsPermissionNotGranted": {
    "description": "Appended after a device's vendor and product id when Android has not yet granted this app access to it. Keep the leading space and dash: it continues a line like '1234:5678'."
  },

  "settingsReadingDevice": "Reading the device…",
  "@settingsReadingDevice": {
    "description": "Shown while the app is interrogating a newly attached DAC."
  },

  "settingsProbing": "Asking the DAC what it supports",
  "@settingsProbing": {
    "description": "Subtitle shown while the app reads a DAC's capabilities — which sample rates and bit depths it can accept."
  },

  "settingsUacTap": "USB Audio Class {version} — tap for what it supports",
  "@settingsUacTap": {
    "description": "Subtitle naming the USB Audio Class version a DAC implements (1 or 2), inviting a tap to see the full capability list. 'USB Audio Class' is the name of the specification and is normally left in English.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "2"
      }
    }
  },

  "settingsConnectToProbe": "Connect a USB DAC and tap to probe",
  "@settingsConnectToProbe": {
    "description": "Subtitle shown when no DAC is attached, inviting the user to plug one in."
  },

  "settingsPcmOnly": "Accept only PCM streams and let the server do the decoding/transcoding",
  "@settingsPcmOnly": {
    "description": "Label for a switch that makes the renderer advertise only uncompressed audio, so the media server converts everything before sending it. PCM and LPCM are format names and are not translated."
  },

  "settingsPcmOnlyOn": "The renderer advertises nothing but LPCM, at the rates this DAC can clock, so the server converts everything to fit. Everything plays and nothing is bit-perfect -- including tracks the DAC could have played untouched.",
  "@settingsPcmOnlyOn": {
    "description": "Explains the consequence of the PCM-only switch being on. The trade is deliberate and the wording should keep its edge: it buys compatibility at the cost of the thing the app exists for."
  },

  "settingsPcmOnlyOff": "The renderer advertises every format it can decode, so files arrive untouched. Tracks at rates this DAC cannot clock are refused, and the reason is shown.",
  "@settingsPcmOnlyOff": {
    "description": "Explains the consequence of the PCM-only switch being off, which is the default and the bit-perfect behaviour."
  },

  "settingsScreenOffAfter": "Turn the screen off after",
  "@settingsScreenOffAfter": {
    "description": "Label for the screen blanking timeout chooser."
  },

  "settingsScreenOffNever": "The screen stays on. Fine on a permanently powered phone, but an OLED panel showing the same screen for months is how it acquires a permanent one.",
  "@settingsScreenOffNever": {
    "description": "Warning shown when the screen timeout is set to Never. The last phrase means the image burns permanently into an OLED panel; keep the warning concrete rather than generic."
  },

  "settingsScreenOffTimed": "Counted from when the music stops -- a long track never blanks the screen mid-play. Playback turns it back on.",
  "@settingsScreenOffTimed": {
    "description": "Explains that the screen timeout is measured from the end of playback rather than from the last touch."
  },

  "settingsTimeoutNever": "Never",
  "@settingsTimeoutNever": {
    "description": "Screen timeout option meaning the display never blanks."
  },

  "settingsTimeoutMinutes": "{minutes, plural, =1{1 minute} other{{minutes} minutes}}",
  "@settingsTimeoutMinutes": {
    "description": "A screen timeout in whole minutes.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "5"
      }
    }
  },

  "settingsDacVerification": "DAC verification",
  "@settingsDacVerification": {
    "description": "Opens a screen that plays test tones at every sample rate a DAC claims, to find out which it really handles."
  },

  "settingsDacVerificationSubtitle": "Test every rate this DAC claims",
  "@settingsDacVerificationSubtitle": {
    "description": "Subtitle for DAC verification. 'Rate' here means sample rate, such as 44100 or 96000 Hz."
  },

  "settingsAlwaysOn": "Always on",
  "@settingsAlwaysOn": {
    "description": "Section heading for the permissions that let the renderer keep running unattended."
  },

  "settingsAlwaysOnHelp": "A dedicated renderer has to keep running with the screen off and come back after a reboot. Android and most phone makers block that by default.",
  "@settingsAlwaysOnHelp": {
    "description": "Explains why the permissions below are needed at all."
  },

  "settingsDeaths": "{count, plural, =1{This phone has stopped the renderer once} other{This phone has stopped the renderer {count} times}}",
  "@settingsDeaths": {
    "description": "Warning headline counting how many times the renderer was killed by the system rather than stopped normally.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "settingsDeathsDetail": "Each one is a start that followed a run which never recorded a clean stop, so something killed it in the background. Granting what is below usually fixes it.",
  "@settingsDeathsDetail": {
    "description": "Explains how the app counts times it was killed: it notices at startup that the previous run never shut down tidily."
  },

  "settingsBattery": "Battery optimisation exemption",
  "@settingsBattery": {
    "description": "Name of the Android permission that stops the system suspending a background app. Use the wording the target language's Android settings actually use, if it differs."
  },

  "settingsBatteryGranted": "Granted — Android will not suspend the renderer.",
  "@settingsBatteryGranted": {
    "description": "Shown when the battery optimisation exemption has been granted."
  },

  "settingsBatteryNotGranted": "Not granted. Android may suspend the renderer when idle.",
  "@settingsBatteryNotGranted": {
    "description": "Shown when the battery optimisation exemption has not been granted."
  },

  "settingsGrant": "Grant",
  "@settingsGrant": {
    "description": "Button that opens the Android screen where a permission can be granted. Short: it is a compact action button."
  },

  "settingsOpenSettings": "Open settings",
  "@settingsOpenSettings": {
    "description": "Button that opens a phone-maker settings screen. Short: a compact action button."
  },

  "settingsCouldNotOpen": "Could not open that screen on this phone.",
  "@settingsCouldNotOpen": {
    "description": "Shown when a phone-maker settings screen the app tried to open does not exist on this device."
  },

  "settingsAutostart": "Autostart ({vendor})",
  "@settingsAutostart": {
    "description": "Names the phone maker's own autostart permission, which is separate from Android's. The vendor is the manufacturer name, such as Xiaomi or Samsung.",
    "placeholders": {
      "vendor": {
        "type": "String",
        "example": "Xiaomi"
      }
    }
  },

  "settingsAutostartVendorFallback": "vendor",
  "@settingsAutostartVendorFallback": {
    "description": "Used in place of the manufacturer name when the phone did not report one, giving 'Autostart (vendor)'. Lower case, since it stands in for a brand name mid-sentence."
  },

  "settingsAutostartDetail": "Phones from this maker usually add background-app restrictions of their own, separate from Android's, and they are the usual reason a renderer does not start after a reboot. The app cannot detect them, only that this maker has such a screen.",
  "@settingsAutostartDetail": {
    "description": "Explains why the app asks about a vendor autostart setting it cannot check for itself."
  },

  "settingsWakeScreen": "Wake the screen when music starts",
  "@settingsWakeScreen": {
    "description": "Name of a permission that lets the renderer light the panel when playback begins."
  },

  "settingsWakeScreenDetail": "Music has played here while the screen stayed dark. Android switches off a screen hold from an app with no window on display, and this phone refused to let the renderer bring its own window up, so the panel lit for a moment and went back to sleep. The permission is usually called something like \"Display pop-up windows while running in the background\", and it is separate from autostart.",
  "@settingsWakeScreenDetail": {
    "description": "Explains why waking the screen needs a vendor permission. The quoted phrase is the name of a setting on the phone; translate it to whatever that setting is actually called in the target language's Android, since the user has to find it."
  },

  "settingsRunSetup": "Run setup again",
  "@settingsRunSetup": {
    "description": "Opens the first-run setup walkthrough again."
  },

  "settingsRunSetupSubtitle": "Walk through the permissions in order",
  "@settingsRunSetupSubtitle": {
    "description": "Subtitle for re-running setup."
  },

  "settingsLanguage": "Language",
  "@settingsLanguage": {
    "description": "Section heading for choosing the interface language."
  },

  "settingsLanguageSystem": "Same as this phone",
  "@settingsLanguageSystem": {
    "description": "The default language option: follow whatever language the phone is set to. Chosen so a guest picking the renderer up finds their own language without configuring anything."
  },

  "settingsLanguageHelp": "The renderer follows this phone unless you choose otherwise. A box set up on a spare phone often inherits a language nobody wanted.",
  "@settingsLanguageHelp": {
    "description": "Explains the language setting and why an override exists."
  }
}
