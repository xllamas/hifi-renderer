      "vendor": {"type": "String", "example": "0x1234"},
      "product": {"type": "String", "example": "0x5678"}
    }
  },

  "dacCapsSampleRates": "Sample rates",
  "@dacCapsSampleRates": {
    "description": "Table row label: the sample rates the DAC accepts, such as 44.1 or 96 kHz."
  },

  "dacCapsBitDepths": "Bit depths",
  "@dacCapsBitDepths": {
    "description": "Table row label: the bit depths the DAC accepts, such as 16 or 24 bit."
  },

  "dacCapsChannels": "Channels",
  "@dacCapsChannels": {
    "description": "Table row label: how many audio channels the DAC takes, normally two."
  },

  "dacCapsCurrentlyAt": "Currently running at",
  "@dacCapsCurrentlyAt": {
    "description": "Table row label: the sample rate the DAC is clocking right now."
  },

  "dacCapsUsbTiming": "USB timing",
  "@dacCapsUsbTiming": {
    "description": "Table row label for which side provides the audio clock."
  },

  "dacCapsVolumeControl": "Volume control",
  "@dacCapsVolumeControl": {
    "description": "Table row label for whether volume can be set over USB."
  },

  "dacCapsDsd": "DSD",
  "@dacCapsDsd": {
    "description": "Table row label for Direct Stream Digital, a one-bit audio format. An abbreviation, normally left as DSD."
  },

  "dacCapsUnknown": "Unknown",
  "@dacCapsUnknown": {
    "description": "Table value when the DAC did not report something."
  },

  "dacCapsRateRange": "{low} – {high} ({count} rates)",
  "@dacCapsRateRange": {
    "description": "Summarises a long list of sample rates as a range plus a count, used when listing them all would not fit.",
    "placeholders": {
      "low": {"type": "String", "example": "44.1 kHz"},
      "high": {"type": "String", "example": "384 kHz"},
      "count": {"type": "int", "example": "9"}
    }
  },

  "dacCapsBitDepth": "{bits}-bit",
  "@dacCapsBitDepth": {
